# Copy to .env for local runs. Never commit real secrets.
OPENAI_API_KEY=

# Realtime defaults used by the MVP live check.
SOKCON_REALTIME_MODEL=gpt-realtime-2
SOKCON_REALTIME_ROUTE=primary
SOKCON_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Optional macOS meeting audio capture input, for example BlackHole.
SOKCON_AUDIO_INPUT_DEVICE=
